{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PELITA: Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}\\frontend"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "base": "$tsc-watch",
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": "Ready in"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "PELITA: Backend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}\\backend"
      },
      "isBackground": true,
      "problemMatcher": [
        {
          "base": "$tsc-watch",
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": "PELITA API listening"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "PELITA: Jalankan frontend + backend",
      "dependsOn": [
        "PELITA: Frontend",
        "PELITA: Backend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "PELITA: Buka aplikasi",
      "type": "shell",
      "command": "Start-Process 'http://localhost:3000/login'",
      "dependsOn": [
        "PELITA: Frontend",
        "PELITA: Backend"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
