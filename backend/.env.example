# Buat database `pelita_db` dan user aplikasi terbatas di phpMyAdmin.
DATABASE_URL="mysql://pelita_backend_app:YOUR_URL_SAFE_PASSWORD@127.0.0.1:3306/pelita_db"
JWT_SECRET="replace-with-at-least-32-random-characters"
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000"
NODE_ENV="development"
SEED_ADMIN_NAME="Pelita Admin"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-strong-password-at-least-12-characters"
